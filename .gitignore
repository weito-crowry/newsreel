# newsreel .gitignore
# 依存パッケージ（npm ci で復元する）
**/node_modules/

# ランナー / Remotion の作業・生成物
**/.tmp/
**/out/
**/__pycache__/
*.py[cod]
dist/

# 合成で生成される音声と尺（runner が production.json から再生成する）
/template/public/audio/*.wav
/template/src/timing.json

# ノード固有の設定ファイル（個人のパスを含むため共有しない。
# 書式は newsreel.example.toml を参照）
newsreel.toml

# Sheets API 直接連携（sheetapi）の秘密情報
# （OAuth クライアントJSONとトークンは絶対に共有しない）
client_secret*.json
newsreel_token.json

# OS / エディタ
.DS_Store
Thumbs.db
